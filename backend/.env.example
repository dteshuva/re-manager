# Backend configuration. Copy to .env and adjust.

# SQLAlchemy / psycopg2 connection URL.
# Supabase example: postgresql+psycopg2://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
DATABASE_URL=postgresql+psycopg2://postgres@localhost:5432/re_manager

# Secret used to sign JWT access tokens. Generate a strong random value in prod.
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Credentials created by `python -m app.seed` for the initial admin user.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin12345

# CORS origin for the Vite dev server.
FRONTEND_ORIGIN=http://localhost:5173
